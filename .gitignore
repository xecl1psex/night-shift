```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.min.js
*.bundle.js

# Logs and temporary files
*.log
*.tmp

# Environment variables
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/
*.coverage

# OS generated files
.DS_Store
Thumbs.db
```